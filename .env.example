# ===================================================
# Personal AI Operating System - Environment Config
# ===================================================

# Platform & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL + pgvector)
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=personal_os_secret
POSTGRES_DB=personal_os_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://personal_os:personal_os_secret@localhost:5432/personal_os_db?schema=public"

# Redis Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Security & Auth
JWT_SECRET=personal_os_super_secure_jwt_secret_change_in_production
ENCRYPTION_KEY=32_byte_hex_string_for_vault_aes256_encryption

# LLM Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Integrations (Phase 3 & Phase 5)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
